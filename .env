# Settings for the Vite dev server (`pnpm dev`) and `pnpm preview`.
# Put personal overrides in `.env.local` (git-ignored); a variable already set in
# the shell takes priority over both files.

# Address of the dental server. The panel calls the API on its own origin and
# Vite forwards those calls (`/dental.v1.*`) here, because the server sends no
# CORS headers.
SERVER_URL=http://localhost:8080
